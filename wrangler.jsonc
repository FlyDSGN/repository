{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "messenger",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "messenger.komaru.space", "custom_domain": true }],
  "workers_dev": false
}
